  "cards": [
    {
      "dot": "emerald",
      "title": "Atomicity",
      "items": [
        "The final path holds a complete file or nothing",
        "Work happens in a temp file inside the destination directory",
        "One rename publishes; a crash leaves only namable debris"
      ]
    },
    {
      "dot": "amber",
      "title": "Idempotent retries",
      "items": [
        "skip treats an existing output as finished work and reads nothing",
        "extract completes a partial set file by file under skip",
        "overwrite replaces atomically for reprocessing pipelines"
      ]
    },
    {
      "dot": "rose",
      "title": "Deterministic failures",
      "items": [
        "Exit classes 2-6 are permanent; retrying them is waste",
        "Only exit 1 and pod-level errors are worth a retry",
        "The terminal JSON event carries the machine-readable error_code"
      ]
    }
  ]
}
